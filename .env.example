# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Create one user in Supabase Authentication > Users, then disable public sign-ups.
SUPABASE_ADMIN_EMAIL=

# Never add a service-role key or admin password to NEXT_PUBLIC_* variables.

# Optional: real GA4 web-stream measurement ID. Empty means no analytics loads.
# Follow SEO-MEASUREMENT.md before enabling, to avoid duplicate page views.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Search Console URL-prefix property HTML verification token.
GOOGLE_SITE_VERIFICATION=
